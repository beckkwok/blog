# Copy this file to `.env` on your NAS and fill in real values.
# docker-compose.prod.yml reads it automatically.
#
# Required (payload won't start without a secret):
PAYLOAD_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# Public site URL, used for canonical URLs, sitemap, RSS and Open Graph.
# Use the address users actually reach (reverse proxy hostname or NAS IP:3000).
NEXT_PUBLIC_SITE_URL=http://192.168.1.10:3000

# Optional: OpenAI + DeepSeek keys
# If OPENAI_API_KEY is empty, set MOCK_EMBEDDINGS=1 so the RAG bot uses
# deterministic mock embeddings and still answers (chat generation still
# uses DEEPSEEK_API_KEY).
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOCK_EMBEDDINGS=1

# Optional: change if you don't want the default postgres password
POSTGRES_PASSWORD=postgres

# NOTE: DATABASE_URL is set by docker-compose.prod.yml (host `postgres`).
# Do not override it with a 127.0.0.1 value here.
